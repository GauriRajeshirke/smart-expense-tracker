# Copy this file to ".env" and fill in your own values. Never commit .env.
NODE_ENV=development
PORT=5000

# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/smart-expense-tracker
# Or MongoDB Atlas (free cloud): paste the connection string from Atlas, e.g.
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/smart-expense-tracker

# Must be a long random string (32+ characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

CLIENT_URL=http://localhost:5173
ML_SERVICE_URL=http://127.0.0.1:8000

# Optional: password for the fake demo account created by "npm run seed"
# DEMO_PASSWORD=Demo@1234
